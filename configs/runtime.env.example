# Copy to .local/credentials/runtime.env and replace paths for the target host.
# Parent directory containing SciTool-Unified, SciTool-LLM, etc.
# SCITOOL_CONDA_ENVS_PATH=/opt/conda/envs
# SCITOOL_LLM_PYTHON=/opt/conda/envs/SciTool-LLM/bin/python
# Optional direct Transformers backend (--backend local; one task at a time).
# SCITOOL_MODEL_PATH=/path/to/Qwen3.5-9B
# SCITOOL_LLM_GPU=6,7

# Scientific tools: leave commented when using the README's .local/ layout.
# If resources are elsewhere, uncomment and replace with absolute paths.
# FORCEGPT_MODEL_PATH=/path/to/ProteinForceGPT
# ESMFOLD_MODEL_PATH=/path/to/esmfold_v1
# OMEGAFOLD_MODEL_PATH=/path/to/OmegaFold
# DEEPTMHMM_MODEL_PATH=/path/to/DeepTMHMM2/checkpoints
# QizhiPei_MODEL_PATH=/path/to/models
# SOLVENT_THERMAL_MODELS=/path/to/MOFSimplify
# RASPA_EXECUTABLE_PATH=/path/to/simulate
