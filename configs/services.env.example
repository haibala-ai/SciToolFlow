# Copy to .local/credentials/services.env; never commit real credentials.
# Generation API (ReAct, SciToolAgent and optional LLM judge).
SCITOOLFLOW_API_BASE=https://api.example.com/v1
SCITOOLFLOW_API_KEY=
SCITOOLFLOW_API_MODEL=
SCITOOLFLOW_API_TOKEN_PARAMETER=max_completion_tokens
SCITOOLFLOW_API_JSON_MODE=1
SCITOOLFLOW_API_STRUCTURED_OUTPUT=0
SCITOOLFLOW_API_TIMEOUT=120
SCITOOLFLOW_API_MAX_COMPLETION_TOKENS=4096
# Optional provider-specific sampling, e.g. {"temperature":0.2,"top_p":0.95}.
SCITOOLFLOW_API_EXTRA_BODY={}

# Local vLLM generation. --backend vllm never uses the generation API key.
SCITOOLFLOW_VLLM_BASE=http://127.0.0.1:8016/v1
SCITOOLFLOW_VLLM_MODEL=Qwen3.5-9B
SCITOOLFLOW_VLLM_TEMPERATURE=0.2
SCITOOLFLOW_VLLM_TOP_P=0.95
SCITOOLFLOW_VLLM_TOP_K=-1
SCITOOLFLOW_VLLM_REPETITION_PENALTY=1.08

# Retrieval embeddings: must match tools/graph/tool_foundation_manifest.json.
# Separate from generation, including when the actor/judge is local.
SCITOOL_EMBEDDING_API_BASE=https://aihubmix.com/v1
SCITOOL_EMBEDDING_API_KEY=

# Tool service credentials. Configure only the services you intend to use.
MP_KEY=
BRAVE_SEARCH_API_KEY=
CHEMSPIDER_API_KEY=
WOLFRAM_ALPHA_APPID=
CHROMA_KEY=

# Local paths and optional resource overrides belong in runtime.env.
