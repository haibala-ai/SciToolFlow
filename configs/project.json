{
  "version": "0.3.0",
  "conda_envs": "SCITOOL_CONDA_ENVS_PATH",
  "model": {
    "backend": "vllm",
    "name": "Qwen3.5-9B",
    "base_url": "http://127.0.0.1:8016/v1"
  },
  "embedding": {
    "model": "text-embedding-3-large",
    "dimensions": 3072,
    "credentials": ".local/credentials/services.env"
  },
  "evaluation": {
    "scientific_tools_only_for_paths": true,
    "missing_predictions": "failure",
    "alternative_paths": "hash_bound_independent_review",
    "default_llm_judge": false
  },
  "react_config": "baselines/react/config.json",
  "tool_catalog": "tools/catalog.json"
}
