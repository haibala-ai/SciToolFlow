{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SciToolFlow public task",
  "type": "object",
  "properties": {
    "id": {"type": "string", "pattern": "^FLOW-[0-9]{4}$"},
    "domain": {"enum": ["Chemical", "Material", "Biology", "MachineLearning"]},
    "question": {"type": "string", "minLength": 1},
    "question_language": {"type": "string"},
    "inputs": {"type": "object"},
    "files": {"type": "array", "items": {"type": "string"}},
    "answer_schema": {"type": "object"},
    "unit_annotations": {"type": "array", "items": {"type": "object"}},
    "max_tool_calls": {"type": "integer", "minimum": 1},
    "Parameter": {"type": "string"}
  },
  "required": ["id", "domain", "question", "inputs", "files", "answer_schema", "max_tool_calls"],
  "additionalProperties": false
}
