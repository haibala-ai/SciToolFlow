#!/usr/bin/env bash
set -euo pipefail
dssp_runtime="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/runtime" && pwd)"
export LD_LIBRARY_PATH="${dssp_runtime}/usr/lib/x86_64-linux-gnu${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
export LIBCIFPP_DATA_DIR="${dssp_runtime}/usr/share/libcifpp"
exec "${dssp_runtime}/usr/bin/mkdssp" "$@"
